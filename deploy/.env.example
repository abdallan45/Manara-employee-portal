# Copy to deploy/.env and change every value marked CHANGE_ME.
# Passwords go into connection URLs: use letters and digits only (for example `openssl rand -hex 24`).
POSTGRES_DB=workforce
# Schema owner: runs the migrations and the backups. Not used by the running API.
POSTGRES_USER=workforce
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
# Runtime role workforce_app (no superuser, no schema changes, insert-only on the audit and
# attendance event tables). Must differ from POSTGRES_PASSWORD.
APP_DB_PASSWORD=CHANGE_ME_other_long_random_password
# Key for the audit hash chain (HMAC-SHA256), at least 32 characters, e.g. `openssl rand -hex 32`.
# Keep a copy outside the server (password safe). Losing it means older audit rows can no longer be verified.
AUDIT_HMAC_KEY=CHANGE_ME_at_least_32_random_characters
# Only after a key rotation: the previous key, so rows written before the rotation still verify.
AUDIT_HMAC_KEY_PREVIOUS=
# LAN server: the server's LAN IP (Caddy listens only here). Public VPS: 0.0.0.0
LAN_BIND_IP=192.168.1.10
# Hostname employees open. LAN: an internal DNS / router name, e.g. attendance.manara.local.
# Public VPS: the real domain whose DNS A record points at the server, e.g. portal.manaralab.tech
SITE_ADDRESS=attendance.manara.local
# Caddyfile = internal CA (LAN). Caddyfile.public = Let's Encrypt certificate (public VPS).
CADDYFILE=Caddyfile
# Public VPS only: Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=
TZ_COMPANY=Asia/Amman
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=2
# Encrypts every dump (openssl AES-256-CBC, PBKDF2), at least 16 characters. Keep a copy outside the
# server: without it the backups cannot be restored. Leave empty only if the backup disk is encrypted.
BACKUP_PASSPHRASE=CHANGE_ME_backup_passphrase
