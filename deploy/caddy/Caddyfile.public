# Public HTTPS on a VPS: Caddy gets and renews a Let's Encrypt certificate for SITE_ADDRESS on its
# own (the DNS record must point at this server and ports 80/443 must be open). Plain HTTP is
# redirected to HTTPS automatically. Caddy replaces any client-supplied X-Forwarded-For with the
# real client address, so the app can trust Caddy's header.
{
	admin off
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
