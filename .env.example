# Workforce platform environment variables.
# Local development: copy apps/api/.env.example to apps/api/.env (the API and Prisma read that file).
# Docker deployment: copy deploy/.env.example to deploy/.env.
#
# DATABASE_URL           PostgreSQL connection string used by Prisma
#                        e.g. postgresql://attendance:CHANGE_ME@127.0.0.1:5433/workforce?schema=public
# PORT                   HTTP port of the API + web app (default 3000)
# HOST                   Bind address (default 0.0.0.0)
# NODE_ENV               development | production | test
# TRUSTED_PROXIES        Comma list of proxy IPs/CIDRs (or loopback) whose X-Forwarded-For is trusted.
#                        Empty = trust nothing (client IP is the TCP peer). Required behind a reverse proxy.
# TZ_COMPANY             Company time zone (default Asia/Amman)
# DEMO_MODE              true enables one-click demo logins (development only; ignored with an error log
#                        when NODE_ENV=production). Only answers loopback TCP peers by default.
# DEMO_ALLOW_REMOTE      true lets non-loopback peers use demo login (default false). Never on a real network.
# DEMO_INCLUDE_ADMINS    true offers SUPER_ADMIN / HR_ADMIN accounts for demo login (default false).
# ALLOWED_ORIGINS        Extra browser origins allowed to send POST/PUT/PATCH/DELETE besides the API's own host,
#                        comma-separated (e.g. http://localhost:3001 for `next dev`). Default empty.
# SWAGGER                true serves /api/docs in production too (default: docs only when NODE_ENV!=production)
# SEED_DEMO_DATA         true seeds fictional demo people + a made-up office location (development only).
#                        Default false: reference data + the admin account, which must change its password.
# WEB_DIST               Path to the static web build (default: apps/web/out)
# SEED_DEFAULT_PASSWORD  Password for users created by the seed; empty = random per user, written to
#                        apps/api/.seed-credentials.txt
# RATE_LIMIT_PER_MINUTE         Global requests/minute per IP (default 300)
# RATE_LIMIT_LOGIN_PER_MINUTE   Login attempts/minute per IP (default 10)

DATABASE_URL="postgresql://attendance:CHANGE_ME@127.0.0.1:5433/workforce?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUSTED_PROXIES=
TZ_COMPANY=Asia/Amman
DEMO_MODE=false
DEMO_ALLOW_REMOTE=false
DEMO_INCLUDE_ADMINS=false
ALLOWED_ORIGINS=
SWAGGER=false
SEED_DEMO_DATA=false
WEB_DIST=
SEED_DEFAULT_PASSWORD=
