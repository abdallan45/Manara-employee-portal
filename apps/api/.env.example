# Copy to apps/api/.env for local development. Never commit real secrets.

# PostgreSQL connection (Prisma). The dev database from `npm run dev:db` listens on 127.0.0.1:5433.
DATABASE_URL="postgresql://attendance:CHANGE_ME@127.0.0.1:5433/workforce?schema=public"

# HTTP listener. In production bind behind the internal reverse proxy only. Use 127.0.0.1 for local development.
PORT=3000
HOST=0.0.0.0

# development | production | test. Under "test" request throttling is disabled unless RATE_LIMIT_IN_TESTS=true.
NODE_ENV=development

# Reverse proxies whose X-Forwarded-For is trusted for the client IP (used for audit entries and rate limits).
# Comma-separated IPs/CIDRs or the keywords loopback, linklocal, uniquelocal. Leave empty to trust nothing
# (the TCP peer address is used), which is the only safe setting without a proxy in front.
TRUSTED_PROXIES=

# Company time zone for work dates, schedules and reports.
TZ_COMPANY=Asia/Amman

# One-click demo login (GET /api/v1/auth/demo/accounts, POST /api/v1/auth/demo/login). Development only:
# ignored (with an error at startup) when NODE_ENV=production, and a warning is logged whenever it is on.
DEMO_MODE=false
# Demo endpoints answer only loopback TCP peers (127.0.0.1 / ::1) unless this is true. Never on a real network.
DEMO_ALLOW_REMOTE=false
# SUPER_ADMIN / HR_ADMIN accounts are hidden from demo login unless this is true.
DEMO_INCLUDE_ADMINS=false

# Extra browser origins allowed to send POST/PUT/PATCH/DELETE besides the API's own host (comma-separated).
# Needed for `next dev` on :3001, whose proxy rewrites the Host header: http://localhost:3001,http://127.0.0.1:3001
ALLOWED_ORIGINS=

# Swagger UI (/api/docs) is served when NODE_ENV is not production, or in production only with SWAGGER=true.
SWAGGER=false

# Location of the static web build (Next.js export). Default: apps/web/out, found automatically.
WEB_DIST=

# Password given to users created by `npm run db:seed`. When empty, a random password is generated per user
# and written to apps/api/.seed-credentials.txt (git-ignored). Minimum 10 characters.
SEED_DEFAULT_PASSWORD=

# true: the seed also creates the fictional demo people and a made-up office location (local development only).
# false (default): reference data + only the `admin` account, which must change its password at first sign-in.
SEED_DEMO_DATA=false

# Optional rate limits (requests per minute per client IP).
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
