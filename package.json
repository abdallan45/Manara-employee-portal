{
  "name": "manara-workforce",
  "version": "0.2.0",
  "private": true,
  "description": "On-premise employee attendance & workforce management platform",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:db": "node dev/start-db.mjs",
    "dev:api": "npm run dev -w @workforce/api",
    "dev:web": "npm run dev -w @workforce/web",
    "build": "npm run build -w @workforce/shared && npm run build -w @workforce/api && npm run build -w @workforce/web",
    "start": "npm run start -w @workforce/api",
    "test": "npm run build -w @workforce/shared && npm test -w @workforce/api",
    "db:migrate": "npm run db:migrate -w @workforce/api",
    "db:seed": "npm run db:seed -w @workforce/api"
  },
  "engines": { "node": ">=20" }
}
